{"ok": true, "data": {"common": {"L:c1": {"description": "document.common.c1", "translations": {"en-US": "<p>Need help? support@voidwall.example</p>"}}}, "pages": {"page1": {"texts": {"L:t1": {"description": "blocks.page1.t1", "translations": {"en-US": "<h1>Hold the Line</h1>"}}, "L:t2": {"description": "blocks.page1.t2", "translations": {"en-US": "<p>Gear up before the Ashfall reaches the gate.</p>"}}, "L:t3": {"description": "blocks.page1.t3", "translations": {"en-US": "Cosmetics"}}, "L:t4": {"description": "blocks.page1.t4", "translations": {"en-US": "<p>Is this pay-to-win?</p>"}}, "L:t5": {"description": "blocks.page1.t5", "translations": {"en-US": "<p>No. Every item in this shop is cosmetic only.</p>"}}, "L:t6": {"description": "blocks.page1.t6", "translations": {"en-US": "<p>All sales final. Refunds per our refund policy and applicable tax law.</p>"}}, "L:t7": {"description": "blocks.page1.t7", "translations": {"en-US": "https://cdn.x/og-image.png"}}, "L:seoTitle": {"description": "page1.seo.title", "translations": {"en-US": "Voidwall Store"}}, "L:seoDesc": {"description": "page1.seo.description", "translations": {"en-US": "Gear up for the Ashfall. Cosmetics, boosts and starter packs for Voidwall."}}, "L:seoImg": {"description": "page1.seo.ogImage", "translations": {"en-US": "https://cdn.x/seo-share.png"}}}}}}}